{
  "name": "scouthub-pc",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:workers": "pnpm --filter @scouthub/web build:workers",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "db:generate": "pnpm --filter @scouthub/database db:generate",
    "db:migrate": "pnpm --filter @scouthub/database db:migrate",
    "db:seed:dev": "pnpm --filter @scouthub/database db:seed:dev",
    "db:studio": "pnpm --filter @scouthub/database db:studio",
    "dev": "turbo run dev --filter @scouthub/web",
    "lint": "turbo run lint && pnpm check:boundaries",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @scouthub/infrastructure test:integration && pnpm --filter @scouthub/web test:integration",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.2.1",
    "eslint": "^9.33.0",
    "eslint-config-next": "^16.2.11",
    "tsx": "^4.20.4",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
