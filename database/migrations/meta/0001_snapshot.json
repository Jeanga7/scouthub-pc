          "value": "\"organization\".\"active_until\" IS NULL OR \"organization\".\"active_from\" IS NULL OR \"organization\".\"active_until\" >= \"organization\".\"active_from\""
        },
        "organization_root_parent_valid": {
          "name": "organization_root_parent_valid",
          "value": "(\"organization\".\"type\" = 'NSO' AND \"organization\".\"parent_id\" IS NULL AND \"organization\".\"id\" = \"organization\".\"tenant_id\" AND \"organization\".\"depth\" = 0) OR (\"organization\".\"type\" <> 'NSO' AND \"organization\".\"parent_id\" IS NOT NULL)"
        },
