{
  "name": "@scouthub/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:workers": "opennextjs-cloudflare build",
    "cf:typegen": "wrangler types",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "dev": "next dev",
    "lint": "eslint .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scouthub/application": "workspace:*",
    "@scouthub/config": "workspace:*",
    "@scouthub/contracts": "workspace:*",
    "@scouthub/observability": "workspace:*",
    "@scouthub/ui": "workspace:*",
    "next": "16.2.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "wrangler": "^4.113.0"
  }
}
